NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_NAME=もんじゃ固定資産管理
APP_NAME_EN=MONJA FIXED ASSET SYSTEM
APP_TIMEZONE=Asia/Tokyo
PUBLIC_BASE_URL=http://localhost:3001
BASE_PATH=/
TRUST_PROXY=false
TRUSTED_PROXY_ADDRESSES=loopback
COOKIE_SECURE=false
DB_SERVER=localhost
DB_PORT=1433
# Named instances: leave DB_PORT empty and set DB_INSTANCE. Do not configure both.
DB_INSTANCE=SQLEXPRESS
DB_NAME=fixed-asset
DB_USER=sa
DB_PASSWORD=CHANGE_ME
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=30000
SESSION_SECRET=CHANGE_TO_LONG_RANDOM_SECRET
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
# Optional: only needed to verify Sites PBKDF2 hashes. Retrieve securely from your Site.
SITES_AUTH_PEPPER=
# Fresh installation setup is loopback-only until initial password has changed.
INITIAL_ADMIN_LOGIN_ID=admin1
# SMTP integration is deliberately disabled until configured.
