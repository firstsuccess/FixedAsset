{
  "name": "monja-fixed-asset-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && tsx watch server/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:sqlserver": "node --import tsx --test tests/sqlserver.integration.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "import:sites": "tsx scripts/import-sites.ts",
    "admin:reset": "tsx scripts/admin-reset.ts",
    "iis:config": "node scripts/iis-config.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mssql": "^12.0.0",
    "dotenv": "^17.0.0",
    "argon2": "^0.44.0",
    "helmet": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "@types/mssql": "^9.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "vite": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tsx": "^4.20.0",
    "esbuild": "^0.28.0"
  }
}